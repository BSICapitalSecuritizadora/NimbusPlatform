# ============================================================
# .env.example.production — Template Seguro para Produção
# 
# IMPORTANTE:
# - Cópia segura contendo apenas as as chaves (sem os valores sensíveis)
# - NUNCA comite um arquivo .env real com dados de produção.
# - Use GitHub Secrets / Azure Key Vault para injetar estes valores.
# ============================================================

APP_NAME="BSI Capital"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://SEU_DOMINIO.com.br
TRUSTED_PROXIES=*
# Requer TRUSTED_PROXIES=* para que X-Forwarded-Proto do front-end do App Service seja lido
FORCE_HTTPS_REDIRECT=true

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ============================================================
# Logging — Info (apenas os mais importantes)
# ============================================================
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ============================================================
# Banco de Dados (Managed Service ou Externa)
# ============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bsicapital_prod
DB_USERNAME=admin_bsicapital
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/var/www/html/ssl/DigiCertGlobalRootCA.crt.pem

# ============================================================
# Configurações de Estado / Cache (Obrigatório: Redis)
# ============================================================
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# Redis gerenciado (Azure Cache for Redis). NUNCA use 127.0.0.1 aqui: o App
# Service não roda Redis local, e apontar para loopback deixa sessão/cache/fila
# num Redis inexistente ou — pior — num Redis aberto na rede.
#
# REDIS_SCHEME=tls é obrigatório: a porta 6380 do Azure só aceita TLS. A porta
# 6379 (texto claro) deve permanecer desabilitada no recurso.
# REDIS_PASSWORD recebe a access key via Key Vault / App Settings — deixe vazio
# aqui. O literal `null` é lido pelo Laravel como "sem senha".
REDIS_CLIENT=phpredis
REDIS_SCHEME=tls
REDIS_HOST=SEU_CACHE.redis.cache.windows.net
REDIS_PORT=6380
REDIS_USERNAME=
REDIS_PASSWORD=

# ============================================================
# Segurança Reforçada (Sessão & Cookies)
# ============================================================
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=SEU_DOMINIO.com.br
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ============================================================
# Storage Remoto (Azure Blob)
# ============================================================
# Disco padrão da aplicação. É ele que recebe as imagens públicas (logos de
# emissões e de bancos) e é ele que o /healthcheck escreve e apaga a cada probe.
# Um disco padrão sem credencial não falha só no upload: derruba o healthcheck,
# e com ele o probe do App Service marca todas as instâncias como não íntegras.
#
# Em produção o valor é `azure` e as duas variáveis abaixo são OBRIGATÓRIAS.
# O container `public` precisa permitir leitura anônima de blob: os logos das
# emissões são servidos direto pela URL pública devolvida por Storage::url().
FILESYSTEM_DISK=azure
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=public

# Alternativa S3 — mantida apenas como referência. O bloco está comentado
# porque o bucket não está provisionado; descomente-o e preencha os valores
# ANTES de apontar FILESYSTEM_DISK=s3.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=sa-east-1
# AWS_BUCKET=bsi-capital-docs
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Token compartilhado do /healthcheck. Sem ele o endpoint continua respondendo
# 200/503 para o probe, mas não revela quais dependências estão degradadas.
HEALTHCHECK_TOKEN=

# ============================================================
# Arquivos Enviados (OBRIGATÓRIO em produção)
# ============================================================
# Raízes dos arquivos enviados pelos usuários. DEVEM ficar fora de
# /home/site/wwwroot: o deploy por zip substitui o conteúdo de wwwroot e
# apagaria os arquivos já enviados. Somente caminho absoluto é aceito.
PRIVATE_STORAGE_ROOT=/home/data/private

# Imagens públicas (logos de bancos, mídias de medições). O symlink
# public/storage é recriado a cada boot pelo startup.sh apontando para cá, e o
# nginx serve /storage/ direto deste diretório.
#
# ATENÇÃO: precisa ser DIFERENTE de PRIVATE_STORAGE_ROOT e não pode conter nem
# estar contido nele. Como o conteúdo desta raiz é servido como arquivo
# estático, apontar as duas para o mesmo lugar publica todos os documentos
# privados. A aplicação e o startup.sh recusam um valor sobreposto e caem no
# diretório padrão, o que derruba as imagens públicas até a correção.
PUBLIC_STORAGE_ROOT=/home/data/public

# Disco dos documentos privados: 'local' (grava em PRIVATE_STORAGE_ROOT) ou
# 'private' (Azure Blob Storage).
#
# ATENÇÃO: a troca NÃO é gradual para todas as tabelas. Só `proposal_files` e
# `documents` guardam o disco em cada linha; as tabelas do Nimbus
# (nimbus_general_documents, nimbus_documents, nimbus_submission_files) não têm
# coluna de disco e são resolvidas por esta variável em tempo de leitura.
# Trocar para 'private' faz todo documento Nimbus já existente ser procurado no
# Blob Storage — migre os arquivos para o container ANTES de trocar.
PRIVATE_FILESYSTEM_DISK=local
# Container privado, usado apenas quando PRIVATE_FILESYSTEM_DISK=private. A
# conexão é a mesma AZURE_STORAGE_CONNECTION_STRING já definida acima.
# AZURE_STORAGE_PRIVATE_CONTAINER=bsi-docs-privados

# ============================================================
# Mail — Microsoft Graph (Entra ID, aplicação `client_credentials`)
# ============================================================
# Em produção o mailer padrão é `graph`: o envio sai pela API do Microsoft Graph
# usando OUTLOOK_TENANT_ID / OUTLOOK_CLIENT_ID / OUTLOOK_CLIENT_SECRET e a caixa
# em OUTLOOK_MAILBOX — todas obrigatórias. O bloco SMTP abaixo permanece para o
# mailer `outlook` (failover das propostas).
MAIL_MAILER=graph
MAIL_SCHEME=tls
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=30
MAIL_FROM_ADDRESS="contato@bsicapital.com.br"
MAIL_FROM_NAME="${APP_NAME}"

PROPOSAL_MAILER=proposal_outlook_failover
PROPOSAL_MAIL_FROM_ADDRESS="contato@bsicapital.com.br"
PROPOSAL_MAIL_FROM_NAME="${APP_NAME}"
PROPOSAL_CONTINUATION_EXPIRES_DAYS=7
PROPOSAL_CONTINUATION_CODE_LENGTH=6

OUTLOOK_MAIL_HOST=smtp.office365.com
OUTLOOK_MAIL_PORT=587
OUTLOOK_MAIL_SCHEME=tls
OUTLOOK_MAIL_USERNAME=
OUTLOOK_MAIL_PASSWORD=
OUTLOOK_MAIL_TIMEOUT=30
OUTLOOK_MAIL_AUTH_MODE=smtp_oauth
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_MAILBOX=

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI="${APP_URL}/auth/azure/callback"

VITE_APP_NAME="${APP_NAME}"

# Gemini AI
GEMINI_API_KEY=

# Upload limits
UPLOAD_ADMIN_RESPONSE_MAX_KB=102400
UPLOAD_DOCUMENT_MAX_KB=102400
UPLOAD_SUBMISSION_MAX_KB=51200
UPLOAD_SUBMISSION_TOTAL_MAX_BYTES=52428800
LIVEWIRE_TEMPORARY_UPLOAD_MAX_KB=102400
LIVEWIRE_TEMPORARY_MAX_UPLOAD_TIME=15

# ============================================================
# Antivírus de uploads (OBRIGATÓRIO em produção)
# ============================================================
# O clamd roda como container sidecar do App Service (imagem clamav/clamav).
#
# ATENÇÃO ao host: sidecars compartilham o namespace de rede do container
# principal e NÃO ganham DNS por nome — o nome que aparece no portal é apenas
# um identificador de deployment. A comunicação é sempre por localhost, então
# o valor tem que ser 127.0.0.1. Um hostname simbólico (clamav, clamav.internal)
# não resolve, e o sintoma é uploads rejeitados com o sidecar rodando ao lado.
#
# CLAMAV_SOCKET precisa existir e ficar VAZIO. O scanner prefere o socket unix
# sempre que ele estiver definido e, se a variável for removida, o caminho unix
# passa a valer e o TCP nunca é tentado.
#
# Só true ou false são aceitos: "enable"/"disable"/"off" derrubam o boot com
# erro explícito, em vez de ligar a varredura por engano.
#
# Configure StreamMaxLength no clamd acima do maior upload permitido (100 MB).
# Após cada deploy há uma janela de 2–5 min até o freshclam carregar a base;
# nela o desenho é fail-closed e os uploads são recusados.
CLAMAV_ENABLED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_SOCKET=
CLAMAV_TIMEOUT=30

# ============================================================
# Retenção de dados pessoais (LGPD art. 15 e 16)
# ============================================================
# Prazo de guarda, em meses, antes do expurgo automático de currículos e
# mensagens de contato. Zero desliga o expurgo daquela base — o que só deve
# acontecer com justificativa registrada, porque a retenção indefinida de dado
# pessoal com finalidade esgotada é a situação que a lei veda.
# Os comandos rodam pelo agendador no dia 1 de cada mês.
LGPD_RETENTION_JOB_APPLICATIONS_MONTHS=12
LGPD_RETENTION_CONTACT_MESSAGES_MONTHS=24
