/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
.env
.env.backup
.env.production
.env.staging
.env.testing
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/auth.json
/.fleet
/.idea
/.nova
/.vscode
/.zed
/.DS_Store
/.codex-artifacts

# Dados operacionais e scripts locais nunca devem ser versionados.
/docs/**/*.xlsx
/fix_*.php
/fix_*.py
/update_*.php
/NUL

# Banco SQLite que o artisan cria quando DB_CONNECTION=sqlite e
# DB_DATABASE=nimbusplatform (sem extensão). Além de ser artefato local, colide
# com NimbusPlatform/ no mount case-insensitive do App Service.
/nimbusplatform

# Diretório aninhado criado por engano por sessões de agente (contém um clone).
/NimbusPlatform/

# Claude harness local settings (machine-specific, not shared)
/.claude/settings.local.json
/.claude/worktrees/

# Stray artifact materialized by some shells from the
# "Composer\Config::disableProcessTimeout" script line in composer.json
/ComposerConfig*

# OS & Editor Trash
*.save
*:Zone.Identifier
*Zone.Identifier
